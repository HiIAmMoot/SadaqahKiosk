# Gradle build outputs
.gradle/
/build/
/app/build/
**/build/

# Local configuration — contains SDK path, never commit
local.properties

# Android Studio project files
.idea/
*.iml

# macOS metadata
.DS_Store

# NDK / CMake
.externalNativeBuild/
.cxx/

# Kotlin compiler error dumps
.kotlin/

# Release artifacts — build from source, never commit binaries
*.apk
*.aab
app/release/
app/debug/

# Signing keys — NEVER commit these
*.keystore
*.jks
keystore.properties

# Captures (Android Studio profiler recordings)
/captures/

# Agent/CI scratch — build and test logs redirected to a file for reading.
# Leaked into a commit twice; ignored so it cannot happen a third time.
test-output.txt
*-test-output.txt
build-output.txt
